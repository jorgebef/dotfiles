# Change display
ctrl + cmd - i : yabai -m display --focus west
ctrl + cmd - o : yabai -m display --focus east

# float / unfloat window and center on screen
ctrl + cmd - u : yabai -m window --toggle float --grid 4:4:1:1:2:2

## Focus next/previous space of current display. No-op if the current space is the last/first space of its display.
# files are located in `.config/bin` which should be added to $PATH
ctrl + cmd - 0x2F : space_focus_next.sh
ctrl + cmd - 0x2B : space_focus_prev.sh

# # cycle forward
# lalt - 0x2F : yabai -m window --focus next || yabai -m window --focus first_node
# # cycle backwards
# lalt - 0x2B : yabai -m window --focus prev || yabai -m window --focus last_node

## Move previous space of current display. No-op if the current space is the first space of its display.
# file is located in `.config/skhd/bin` which should be added to $PATH
# lalt + shift - 0x2F : \
#   cur_window="yabai -m query --windows --window | jq '.id'"\
#   window_move_next_space.sh ${cur_window}
# ctrl + cmd + shift - 0x2F : window_move_next_space.sh
# ctrl + cmd + shift - 0x2B : window_move_prev_space.sh



# # Focus next space by mission-control index
# lalt - 0x2F : yabai -m space --focus next
#  # Focus previous space by mission-control index
# lalt - 0x2B : yabai -m space --focus prev

ctrl + cmd - return : yabai -m window --toggle zoom-parent

# lalt + cmd - 0x18 : yabai -m window --resize bottom_right:0:200
# lalt + cmd - - : yabai -m window --resize right:-200

ctrl + cmd + shift - i : yabai -m window --display west; yabai -m display --focus west
ctrl + cmd + shift - o : yabai -m window --display east; yabai -m display --focus east

ctrl + cmd - h : yabai -m window --focus west
ctrl + cmd + shift - h : yabai -m window --swap west

ctrl + cmd - l : yabai -m window --focus east
ctrl + cmd - n : yabai -m window --focus "$(yabai -m query --windows --space | jq -re "[sort_by(.id, .frame) | reverse | .[] | select(.role == \"AXWindow\" and .subrole == \"AXStandardWindow\") | .id] | nth(index($(yabai -m query --windows --window | jq -re ".id")) - 1)")"
ctrl + cmd + shift - l : yabai -m window --swap east

